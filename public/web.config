<?xml version="1.0" encoding="utf-8"?>
<!--
  QA Lab — configuración IIS para el SPA.

  Este archivo vive en public/ y Vite lo copia a dist/ en cada `npm run build`,
  así que no hay que acordarse de subirlo aparte.

  Supone: la API Express (server/index.ts) corre en el MISMO servidor, en
  http://localhost:3001, e IIS le hace de reverse proxy en /api.

  Requisitos en el servidor IIS:
    - URL Rewrite 2.1
    - Application Request Routing (ARR) 3.0, con el proxy habilitado
  Ver las notas al final para los comandos.
-->
<configuration>
  <system.webServer>

    <!-- ── MIME types que IIS no conoce de fábrica ──────────────────────────
         Sin esto, IIS devuelve 404 para .woff2/.webmanifest y sirve los .js
         de los módulos con el content-type equivocado. -->
    <staticContent>
      <remove fileExtension=".js" />
      <mimeMap fileExtension=".js" mimeType="application/javascript" />
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="application/javascript" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".map" />
      <mimeMap fileExtension=".map" mimeType="application/json" />
    </staticContent>

    <!-- ── Compresión ──────────────────────────────────────────────────── -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />
    <httpCompression>
      <staticTypes>
        <add mimeType="text/*" enabled="true" />
        <add mimeType="application/javascript" enabled="true" />
        <add mimeType="application/json" enabled="true" />
        <add mimeType="image/svg+xml" enabled="true" />
        <add mimeType="*/*" enabled="false" />
      </staticTypes>
      <dynamicTypes>
        <add mimeType="text/*" enabled="true" />
        <add mimeType="application/javascript" enabled="true" />
        <add mimeType="application/json" enabled="true" />
        <!-- SSE nunca se comprime: romperia el streaming de logs en vivo -->
        <add mimeType="text/event-stream" enabled="false" />
        <add mimeType="*/*" enabled="false" />
      </dynamicTypes>
    </httpCompression>

    <rewrite>
      <rules>

        <!-- 1) API → Express. Va PRIMERO: si no, el fallback del SPA se
                traga las llamadas y devuelve index.html en vez de JSON. -->
        <rule name="ProxyApiToExpress" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://localhost:3001/api/{R:1}" />
          <serverVariables>
            <!-- Para que Express vea el host/protocolo reales detrás del proxy -->
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_PROTO" value="{MapScheme:{HTTPS}}" />
          </serverVariables>
        </rule>

        <!-- 2) Fallback del SPA.
                La app enruta por URL (ej. /checklist/:id), así que un enlace
                directo debe devolver index.html y dejar que React resuelva.
                Solo aplica si NO existe el archivo ni el directorio pedido. -->
        <rule name="SpaFallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/api/" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>

      </rules>

      <!-- {HTTPS} vale on|off; esto lo traduce a https|http para X-Forwarded-Proto -->
      <rewriteMaps>
        <rewriteMap name="MapScheme" defaultValue="http">
          <add key="on" value="https" />
          <add key="off" value="http" />
        </rewriteMap>
      </rewriteMaps>
    </rewrite>

    <!-- ── Caché ───────────────────────────────────────────────────────────
         index.html NO se cachea: es el que apunta a los bundles nuevos.
         Si se cachea, los usuarios siguen viendo la versión vieja tras un
         deploy. Los archivos de /assets sí, porque llevan hash en el nombre. -->
    <location path="index.html">
      <system.webServer>
        <staticContent>
          <clientCache cacheControlMode="DisableCache" />
        </staticContent>
      </system.webServer>
    </location>

    <location path="assets">
      <system.webServer>
        <staticContent>
          <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
        </staticContent>
      </system.webServer>
    </location>

    <!-- ── Cabeceras ──────────────────────────────────────────────────── -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering>
        <!-- Subida de evidencias/grabaciones: 100 MB -->
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>

    <!-- PassThrough es lo importante: deja pasar el JSON de error de Express
         en vez de reemplazarlo por la página de error de IIS. -->
    <httpErrors errorMode="DetailedLocalOnly" existingResponse="PassThrough" />

  </system.webServer>
</configuration>

<!--
  ─────────────────────────────────────────────────────────────────────────
  PASOS EN EL SERVIDOR (una sola vez)
  ─────────────────────────────────────────────────────────────────────────

  1. Instalar en IIS (Web Platform Installer o descarga directa):
       - URL Rewrite 2.1
       - Application Request Routing 3.0

  2. Habilitar el proxy de ARR (sin esto la regla ProxyApiToExpress da 404):
       IIS Manager → nodo del servidor → Application Request Routing Cache
       → Server Proxy Settings → tildar "Enable proxy" → Apply

     O por consola, como administrador:
       %windir%\system32\inetsrv\appcmd.exe set config -section:system.webServer/proxy ^
         /enabled:"True" /commit:apphost

  3. Desactivar el buffering de respuesta de ARR.
     IMPORTANTE: la pantalla de ejecución en vivo usa Server-Sent Events
     (text/event-stream). Con el buffering por defecto de ARR, los logs no
     aparecen hasta que la corrida termina. Como administrador:

       %windir%\system32\inetsrv\appcmd.exe set config -section:system.webServer/proxy ^
         /responseBufferThreshold:"0" /commit:apphost

  4. Permitir que las reglas escriban las server variables del proxy:
       IIS Manager → sitio → URL Rewrite → View Server Variables →
       agregar HTTP_X_FORWARDED_HOST y HTTP_X_FORWARDED_PROTO

  5. Dejar la API Express corriendo como servicio en el puerto 3001
     (PM2, NSSM o un servicio de Windows). IIS no la levanta sola.
     Su archivo .env con las credenciales de Jira/TestRail va junto a ella,
     NO dentro del sitio estático.
-->

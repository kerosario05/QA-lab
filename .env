JIRA_DEFECT_PROJECT_KEY=GDD
VITE_JIRA_PROJECT_KEY=GDD
JIRA_DEFECT_ISSUE_TYPE=Story
# JIRA_DEFECT_ASSIGNED_TRANSITION = transition name after assignee is set (default: Asignado)
JIRA_DEFECT_ASSIGNED_TRANSITION=Asignado

